load("@rules_shell//shell:sh_test.bzl", "sh_test")

genrule(
    name = "_nvim_test_runner",
    outs = ["_nvim_test_runner.sh"],
    cmd = """cat > $@ << 'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
cd "$$TEST_SRCDIR/$$TEST_WORKSPACE"
MINI="$$HOME/.local/share/nvim/lazy/mini.nvim"
if [ ! -d "$$MINI" ]; then
  echo "ERROR: mini.nvim not found at $$MINI" >&2
  exit 1
fi
if [ "$$#" -gt 0 ]; then
  RUN_CMD="lua MiniTest.run_file('$$1')"
else
  RUN_CMD="lua MiniTest.run()"
fi
exec nvim --headless --noplugin -u NONE \
  -c "set rtp+=." \
  -c "set rtp+=$$MINI" \
  -c "lua MiniTest = require('mini.test')" \
  -c "lua MiniTest.setup({ execute = { reporter = MiniTest.gen_reporter.stdout({ group_depth = 2 }) } })" \
  -c "$$RUN_CMD" \
  -c "qa!"
SCRIPT
chmod +x $@
""",
)

# The runner takes nvim from PATH and mini.nvim from HOME.
_TEST_ENV = [
    "HOME",
    "PATH",
]

_TEST_DATA = glob([
    "lua/**/*.lua",
    "tests/**/*.lua",
])

[sh_test(
    name = name,
    srcs = [":_nvim_test_runner"],
    args = ["tests/%s.lua" % name],
    data = _TEST_DATA,
    env_inherit = _TEST_ENV,
    tags = ["local"],
) for name in [
    "test_swap_handler",
    "test_formattable",
    "test_format_progress",
    "test_format_files",
    "test_format_report",
    "test_project_hooks",
]]

sh_test(
    name = "test_all",
    srcs = [":_nvim_test_runner"],
    data = _TEST_DATA,
    env_inherit = _TEST_ENV,
    tags = ["local"],
)
